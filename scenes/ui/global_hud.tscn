[gd_scene load_steps=3 format=3 uid="uid://global_hud"]

[ext_resource type="Script" path="res://scripts/ui/global_hud.gd" id="1_hud"]
[ext_resource type="PackedScene" uid="uid://lobby_screen" path="res://scenes/ui/lobby.tscn" id="2_lobby"]

[node name="GlobalHUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Music" type="AudioStreamPlayer" parent="."]
stream = null
bus = &"Master"

[node name="StartPanel" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.06, 0.1, 0.92)

[node name="Lobby" parent="StartPanel" instance=ExtResource("2_lobby")]
layout_mode = 1

[node name="CountdownPanel" type="ColorRect" parent="."]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.45)
mouse_filter = 2

[node name="CountdownCenter" type="CenterContainer" parent="CountdownPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="CountdownLabel" type="Label" parent="CountdownPanel/CountdownCenter"]
layout_mode = 2
theme_override_font_sizes/font_size = 120
text = "3"
horizontal_alignment = 1
vertical_alignment = 1

[node name="EndPanel" type="PanelContainer" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -120.0
offset_right = 260.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2

[node name="EndVBox" type="VBoxContainer" parent="EndPanel"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="WinnerLabel" type="Label" parent="EndPanel/EndVBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 48
text = "Team A Won!"
horizontal_alignment = 1

[node name="ScoreLabel" type="Label" parent="EndPanel/EndVBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 28
text = "A: 0  |  B: 0"
horizontal_alignment = 1

[node name="RestartPrompt" type="Label" parent="EndPanel/EndVBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 28
text = "Press X to restart"
horizontal_alignment = 1
